	executorch-$_executorch.tar.gz::$_gh/pytorch/executorch/archive/$_executorch.tar.gz
	XNNPACK-$_xnnpack.tar.gz::$_gh/google/XNNPACK/archive/$_xnnpack.tar.gz
	cpuinfo-$_cpuinfo.tar.gz::$_gh/pytorch/cpuinfo/archive/$_cpuinfo.tar.gz
	pthreadpool-$_pthreadpool.tar.gz::$_gh/google/pthreadpool/archive/$_pthreadpool.tar.gz
	FXdiv-$_fxdiv.tar.gz::$_gh/Maratyszcza/FXdiv/archive/$_fxdiv.tar.gz
	FP16-$_fp16.tar.gz::$_gh/Maratyszcza/FP16/archive/$_fp16.tar.gz
	flatbuffers-$_flatbuffers.tar.gz::$_gh/google/flatbuffers/archive/$_flatbuffers.tar.gz
	flatcc-$_flatcc.tar.gz::$_gh/dvidelabs/flatcc/archive/$_flatcc.tar.gz
	json-$_json.tar.gz::$_gh/nlohmann/json/archive/$_json.tar.gz
	gflags-$_gflags.tar.gz::$_gh/gflags/gflags/archive/$_gflags.tar.gz
	kleidiai-$_kleidiai.tar.gz::$_gh/ARM-software/kleidiai/archive/$_kleidiai.tar.gz
	pytorch-$_pytorch.tar.gz::$_gh/pytorch/pytorch/archive/refs/tags/v$_pytorch.tar.gz
	futo-swipe-LICENSE.md::$_hf/LICENSE.md
	honorable_sturgeon-model_fp32.pte::$_hf/honorable_sturgeon/model_fp32.pte
	honorable_sturgeon-metadata.json::$_hf/honorable_sturgeon/metadata.json
	magic_macaw-model_fp32.pte::$_hf/magic_macaw/model_fp32.pte
	magic_macaw-metadata.json::$_hf/magic_macaw/metadata.json
	"
builddir="$srcdir/futo-osk-$pkgver"

prepare() {
	default_prepare

	# ExecuTorch insists on being in a directory named "executorch".
	mv "$srcdir"/executorch-$_executorch "$srcdir"/executorch

	# Its submodules, as far as this build uses them.
	local et="$srcdir"/executorch dir path
	for dir in \
		XNNPACK-$_xnnpack:backends/xnnpack/third-party/XNNPACK \
		cpuinfo-$_cpuinfo:backends/xnnpack/third-party/cpuinfo \
		pthreadpool-$_pthreadpool:backends/xnnpack/third-party/pthreadpool \
		FXdiv-$_fxdiv:backends/xnnpack/third-party/FXdiv \
		FP16-$_fp16:backends/xnnpack/third-party/FP16 \
		flatbuffers-$_flatbuffers:third-party/flatbuffers \
		flatcc-$_flatcc:third-party/flatcc \
		json-$_json:third-party/json \
		gflags-$_gflags:third-party/gflags
	do
		path=${dir#*:}
		rm -rf "$et/$path"
		mv "$srcdir/${dir%%:*}" "$et/$path"
	done

	# torchgen reads ATen's operator definitions from torchgen/packaged/,
	# which PyTorch's setup.py fills in for its wheels.
	local torch="$srcdir"/pytorch-$_pytorch
	mkdir -p "$torch"/torchgen/packaged/ATen/native
	cp "$torch"/aten/src/ATen/native/*.yaml "$torch"/torchgen/packaged/ATen/native/
	cp -r "$torch"/aten/src/ATen/templates "$torch"/torchgen/packaged/ATen/
}

build() {
	PYTHONPATH="$srcdir"/pytorch-$_pytorch \
	KLEIDIAI_SOURCE_DIR="$srcdir"/kleidiai-$_kleidiai \
		sh swipe-decoder/build-executorch.sh \
		"$srcdir"/executorch \
		"$srcdir"/swipe-library-$_swipe_library \
		"$srcdir"/executorch-build

	cmake -B output -S swipe-decoder -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBEXECDIR=libexec \
		-DSWIPE_LIBRARY_DIR="$srcdir"/swipe-library-$_swipe_library \
		-DEXECUTORCH_ROOT="$srcdir"/executorch \
		-DET_BUILD="$srcdir"/executorch-build
	cmake --build output
}

package() {
	DESTDIR="$pkgdir" cmake --install output

	local model file
	for model in honorable_sturgeon magic_macaw; do
		for file in model_fp32.pte metadata.json; do
			install -Dm644 "$srcdir"/$model-$file \
				"$pkgdir"/usr/share/$pkgname/$model/$file
		done
	done
	install -Dm644 swipe-decoder/LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 "$srcdir"/futo-swipe-LICENSE.md \
		"$pkgdir"/usr/share/licenses/$pkgname/FUTO-Model-Weights-LICENSE.md
}

