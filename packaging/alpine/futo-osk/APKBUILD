# Maintainer: Jay Harris <jay.harris@outlook.co.nz>
pkgname=futo-osk
pkgver=0.2.0
pkgrel=0
_futo_commit=7d61ab4132cfcbb7aa713190d934f0125dc38b03
_resources_commit=d87d9dbdf3966bbe18413be375dab2f6c7bbdfdd
pkgdesc="Phosh on-screen keyboard with FUTO Keyboard's transformer prediction, autocorrect and swipe typing"
url="https://github.com/fallaciousreasoning/futo-osk"
arch="aarch64 x86_64"
# FUTO's engine and model are under the FUTO Source First License:
# non-commercial use and free distribution only.
license="LicenseRef-FUTO-SFL-1.1-kb AND Apache-2.0 AND MIT"
makedepends="
	feedbackd-dev
	gtk4-layer-shell-dev
	gtk4.0-dev
	libxkbcommon-dev
	meson
	wayland-dev
	"
# Takes over stevia's sm.puri.OSK0.desktop and mobi.phosh.OSK.service, so
# phosh starts this keyboard instead.
provides="phosh-keyboard phosh-osk-stub"
replaces="stevia stevia-systemd"
subpackages="$pkgname-systemd"
# The typing test needs gtk4-broadwayd and a session bus.
options="!check"
source="$pkgname-$pkgver.tar.gz::https://github.com/fallaciousreasoning/futo-osk/archive/refs/tags/v$pkgver.tar.gz
	futo-android-keyboard-$_futo_commit.tar.gz::https://github.com/futo-org/android-keyboard/archive/$_futo_commit.tar.gz
	futo-resources-$_resources_commit.tar.gz::https://gitlab.futo.org/keyboard/keyboard-large-resources/-/archive/$_resources_commit/keyboard-large-resources-$_resources_commit.tar.gz
	"

prepare() {
	default_prepare
	mkdir -p futo
	mv "$srcdir"/android-keyboard-$_futo_commit futo/android-keyboard
	mv "$srcdir"/keyboard-large-resources-$_resources_commit futo/resources
}

build() {
	abuild-meson \
		-Dfuto_resources="$builddir"/futo/resources \
		-Dlayer_shell=enabled \
		-Dfeedback=enabled \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 futo/android-keyboard/LICENSE.md \
		"$pkgdir"/usr/share/licenses/$pkgname/FUTO-LICENSE.md
}

systemd() {
	pkgdesc="$pkgdesc (systemd user unit)"
	install_if="systemd $pkgname=$pkgver-r$pkgrel"
	replaces="stevia-systemd"
	amove usr/lib/systemd/user
}

