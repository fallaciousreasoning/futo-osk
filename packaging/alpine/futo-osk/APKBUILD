5f73fa2698b2e0e1db93db0485a214c6fd3298a04f221012fa7b765f7f5a80e3d8c8d566e94fd4d8aa3e96d8eec8d0e5c301d2ede2f5ad92f3814568a7359fbc  futo-android-keyboard-7d61ab4132cfcbb7aa713190d934f0125dc38b03.tar.gz
cef064f4f937694466bd50f96b63bb5ce131a9993711c26852be9ef93c2c434837f420c103214d5ff39be814a510d24dba6c338027f047a5e24ea45b84321973  futo-resources-d87d9dbdf3966bbe18413be375dab2f6c7bbdfdd.tar.gz
