# systemd user unit started by phosh's mobi.phosh.OSK.target when
# gnome-session runs under systemd (which ignores sm.puri.OSK0.desktop).

[Unit]
Description=futo-osk on-screen keyboard
CollectMode=inactive-or-failed

After=gnome-session-initialized.target
PartOf=mobi.phosh.OSK.target

[Service]
Slice=session.slice
Type=dbus
BusName=sm.puri.OSK0
ExecStart=@bindir@/futo-osk
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5
